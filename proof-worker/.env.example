# Haven Proof Worker Configuration

# SP1 Network private key for remote proving
# Get one from: https://network.succinct.xyz
SP1_PRIVATE_KEY=

# Proof system: "plonk" (default, used for CKB on-chain verification) or "groth16"
DCAP_PROOF_SYSTEM=plonk

# SP1 Network prover mode: "auction" (default, cheapest), "hosted", or "reserved"
DCAP_NETWORK_MODE=auction

# Ethereum RPC URL for fetching DCAP collaterals from Automata's on-chain PCCS.
# This is a standard Ethereum RPC (Alchemy, Infura, Ankr, etc.) for any chain
# where Automata has deployed their PCCS contracts:
#
#   Ethereum Sepolia (testnet): PCCSRouter at 0x8e480c9879F1Db31dC209e5f4d239d5126e6e07B
#   Ethereum Mainnet:           PCCSRouter at 0xE2Cd5aA44a0896D683684B8EA15eB54B269fC933
#   Base Sepolia:               PCCSRouter at 0xa4615C2a260413878241ff7605AD9577feB356A5
#   Arbitrum Sepolia:           PCCSRouter at 0xa4615C2a260413878241ff7605AD9577feB356A5
#
# Example (Sepolia): https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Example (Mainnet): https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
#
# Not needed for local dev with dstack simulator (no real proofs generated).
AUTOMATA_RPC_URL=

# Server port (default: 3001)
PORT=3001

# TEE service URL (proof worker sends proofs back to TEE)
TEE_URL=http://localhost:3000
